<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_mapping</name>
  <version>0.0.0</version>
  <description>
    The mapping back end. pgo_node: pose-graph optimisation over
    syncai_pointlio's odometry and body clouds -- keyframes, loop closure
    (GTSAM iSAM2), the map -&gt; pointlio_odom correction TF, the "map so far"
    hand-off to the operator console, and the save_maps / reset_mapping
    services that bracket a mapping run. Ported from SyncAI-Fast-LIO2
    (`pgo`; liangheming/FASTLIO2_ROS2 lineage) in 2026-09. The fork's `hba`
    came over as a second node too and was removed in 2026-10, unused.
  </description>
  <maintainer email="chungweeeei@gmail.com">andy_tseng</maintainer>
  <!-- MIT: pgos/ is upstream-derived and LICENSE is theirs. -->
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>message_filters</depend>
  <!-- StartMapping / SaveMaps / ResetMapping (served) and ResetLIO (client);
       from `vcs import < dependencies.repos`. -->
  <depend>syncai_common</depend>
  <!-- Loop verification. Not a rosdep key: a src/third-party cmake package
       this line orders first. -->
  <depend>small_gicp</depend>
  <!-- pgo_node locates the clean_map executable it spawns. -->
  <depend>ament_index_cpp</depend>
  <!-- clean_map: voxel keys, ray traversal and the optional octomap.bt.
       A real rosdep key (ros-humble-octomap). -->
  <depend>octomap</depend>
  <!-- The map_cloud_file notice and map_clean.recipe.json (nlohmann-json3-dev). -->
  <depend>nlohmann-json-dev</depend>

  <!-- Not listed on purpose: PCL / Eigen come through pcl_conversions.
       GTSAM is source-built into /usr/local and has no matching rosdep key,
       so a <depend> would only make `rosdep check` fail. -->

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
