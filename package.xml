<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>syncai_robot_3d_mapping</name>
  <version>0.1.0</version>
  <description>3D mapping node for the SyncAI robot stack (rclrs)</description>
  <maintainer email="chungweeeei@gmail.com">chunwei</maintainer>
  <license>Apache-2.0</license>

  <depend>rclrs</depend>
  <depend>rosidl_runtime_rs</depend>
  <!-- Message packages are declared here, NOT in Cargo.toml: colcon-ros-cargo puts them on
       AMENT_PREFIX_PATH and wires them into the `ros_env` crate at build time, and without a
       <depend> here `ros_env::<pkg>` simply does not exist. -->
  <depend>std_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
