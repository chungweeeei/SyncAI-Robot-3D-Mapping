root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C++ and CMake follow the ROS 2 / Google style in .clang-format (2-space indent)
[*.{cpp,hpp,h,c}]
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[*.{xml,yml,yaml,json}]
indent_size = 2
